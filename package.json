{
  "name": "nyang-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "slice": "python3 scripts/slice-sprites.py",
    "recolor": "python3 scripts/recolor-sprites.py",
    "gen:synergies": "node --experimental-strip-types scripts/gen-synergies.mjs",
    "gen:contracts": "node --experimental-strip-types scripts/gen-raid-contracts.mjs",
    "contract:test": "node --experimental-strip-types scripts/raid-contract-validator-test.mjs && node --experimental-strip-types scripts/raid-contract-flow-test.mjs",
    "contracts": "node --experimental-strip-types scripts/contract-space.mjs",
    "sim": "node --experimental-strip-types scripts/balance-sim.mjs",
    "sweep": "node --experimental-strip-types scripts/balance-sweep.mjs",
    "test": "node --experimental-strip-types scripts/validator-test.mjs",
    "probe": "node --experimental-strip-types scripts/layout-probe.mjs",
    "input:test": "node --experimental-strip-types scripts/input-routing-test.mjs",
    "docs": "python3 scripts/md2pdf.py",
    "decisions": "node --experimental-strip-types scripts/decision-space.mjs",
    "placement": "node --experimental-strip-types scripts/placement-space.mjs",
    "intervention": "node --experimental-strip-types scripts/intervention-space.mjs",
    "dodge:test": "node --experimental-strip-types scripts/dodge-test.mjs",
    "strike:test": "node --experimental-strip-types scripts/strike-test.mjs",
    "audio:test": "node --experimental-strip-types scripts/audio-signal-test.mjs",
    "audio:runtime:test": "node --experimental-strip-types scripts/audio-runtime-test.mjs",
    "asset:test": "node --experimental-strip-types scripts/asset-contract-test.mjs",
    "submission:test": "node --experimental-strip-types scripts/submission-copy-test.mjs",
    "qa:manual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manual-qa.ps1",
    "trace": "node --experimental-strip-types scripts/run-trace.mjs",
    "relics": "node --experimental-strip-types scripts/relic-space.mjs",
    "map": "node --experimental-strip-types scripts/map-policy-test.mjs && node --experimental-strip-types scripts/map-prep-space.mjs && node --experimental-strip-types scripts/map-space.mjs",
    "map:observe": "node --experimental-strip-types scripts/map-space.mjs",
    "gold": "node --experimental-strip-types scripts/gold-curve.mjs",
    "measure:all": "node scripts/measure-all.mjs",
    "verify": "npm run typecheck && npm test && npm run contract:test && npm run contracts && npm run clear:test && npm run outcome:test && npm run submission:test && npm run probe && npm run input:test && npm run dodge:test && npm run strike:test && npm run audio:test && npm run audio:runtime:test && npm run asset:test && npm run invariants && vite build && npm run measure:all",
    "typecheck": "tsc --noEmit",
    "metrics": "node --experimental-strip-types scripts/metrics-gen.mjs",
    "formation": "node --experimental-strip-types scripts/formation-space.mjs",
    "null": "node --experimental-strip-types scripts/null-model.mjs",
    "invariants": "node --experimental-strip-types scripts/invariants.mjs",
    "tiers": "node --experimental-strip-types scripts/synergy-tiers.mjs",
    "clear": "node --experimental-strip-types scripts/clear-space.mjs",
    "clear:test": "node --experimental-strip-types scripts/clear-bots-test.mjs",
    "outcome:test": "node --experimental-strip-types scripts/battle-outcome-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "description": "악몽 계약으로 다음 보스의 패턴·위험·보상을 고르는 픽셀 고양이 레이드 오토배틀러"
}
